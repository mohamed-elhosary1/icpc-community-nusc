{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" }
  ],
  "redirects": [
    { "source": "/participant/(.*)", "destination": "/login", "permanent": false },
    { "source": "/participant", "destination": "/login", "permanent": false },
    { "source": "/events/(.*)", "destination": "/", "permanent": false },
    { "source": "/events", "destination": "/", "permanent": false }
  ]
}
